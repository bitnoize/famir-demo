{
	default_bind 0.0.0.0

	log famir {
		output file /var/log/caddy/fake-mirrors.log {
			mode 640
			roll_size 10MiB
			roll_keep 1
		}

		format json
    include http.log.access
	}
}

(mirror) {
	https://{args[0]}:{args[1]} {
		log famir

		@cloudflare {
			remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		}

		handle @cloudflare {
			encode zstd gzip

			reverse_proxy 127.0.0.1:3000 {
				header_up -cf-ray
				header_up -cf-request-id
				header_up -cf-visitor
				header_up -cf-worker
				header_up -cf-cache-status
				header_up -cf-connecting-ip
				header_up -cf-ipcountry
				header_up -cdn-loop

				header_up Host {args[0]}:{args[1]}
				header_up X-Real-Ip {http.request.header.cf-connecting-ip}
			}
		}

		handle {
			respond "Access Denied" 403
		}
	}
}

