{
	auto_https off
	default_bind 127.0.0.1
}

(mirror) {
	http://{args[0]}:{args[1]} {
		encode zstd gzip

		reverse_proxy 127.0.0.1:3000 {
			header_up Host {args[0]}:{args[1]}
			header_up X-Real-Ip {remote_host}
		}
	}
}

